# Required: API key for the chat model, through an OpenAI-compatible endpoint. Gemini by default
# (https://aistudio.google.com/apikey). LLM_API_KEY is accepted instead of GEMINI_API_KEY.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides
# BETTY_MODEL=gemini-3.1-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# To use NVIDIA instead, set all four (the key goes in LLM_API_KEY, not GEMINI_API_KEY):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_API_KEY=your-nvidia-api-key-here
#   BETTY_MODEL=nemotron-3.5
#   QUERY_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# BETTY_TEMPERATURE=0.7
# BETTY_MAX_TOKENS=      # unset = no cap (a cap can be used up by the model's reasoning)
# REQUEST_TIMEOUT_SECONDS=60   # Betty's LLM and the OSM query LLM
# LOG_LEVEL=INFO   # DEBUG also logs full LLM request payloads

# OpenStreetMap place search (find_places, run by Betty's search_places tool)
# QUERY_MODEL=gemini-3.1-flash-lite   # the model that writes the Overpass queries
# BETTY_PLACES_TOOL=true
# PLACES_TEMPERATURE=0.2   # 0 = strictly the best-known places, 1 = random among the 150 best known
# Comma-separated, tried in order (default: overpass-api.de, then private.coffee).
# For the local instance from compose.overpass.yaml (Mazowieckie only):
# OVERPASS_URLS=http://localhost:12345/api/interpreter
# BetterTravel backend (events tool); start it with `docker compose up` in backend-server
# Sight guide: web search for questions the Wikipedia article cannot answer (tavily.com)
# TAVILY_API_KEY=tvly-...
# GUIDE_MODEL=              # defaults to BETTY_MODEL
# GUIDE_MAX_SEARCHES=2

# BACKEND_URL=http://localhost:8080   # events on the trip's dates (Warsaw)
# BETTY_EVENTS_TOOL=true

# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
