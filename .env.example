# Required: NVIDIA Integrate API key (https://build.nvidia.com)
NVIDIA_API_KEY_2=your-nvidia-api-key-here

# Optional overrides
# BETTY_MODEL=nemotron-3.5
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# BETTY_TEMPERATURE=0.7
# BETTY_MAX_TOKENS=1024
# REQUEST_TIMEOUT_SECONDS=60   # Betty's LLM and the OSM query LLM
# LOG_LEVEL=INFO   # DEBUG also logs full LLM request payloads

# OpenStreetMap place search (find_places, run by Betty's search_places tool)
# NVIDIA_API_KEY_1=your-nvidia-api-key-here   # preferred; NVIDIA_API_KEY_2 is the fallback
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# BETTY_PLACES_TOOL=true
# Comma-separated, tried in order (default: overpass-api.de, then private.coffee)
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
